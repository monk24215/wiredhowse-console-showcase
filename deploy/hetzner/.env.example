# /opt/wiredhowse-console/.env — fill in, chmod 600. Never commit.

# Console's bundled Postgres (used by docker-compose.yml to build DATABASE_URL)
POSTGRES_PASSWORD=

# Hostname the console itself is served on (must be a DNS-only A record -> <SERVER_IP>)
CONSOLE_HOST=fastassets.wiredhowse.app

# Assets are served at wh-asset-<id>.<ASSET_BASE_DOMAIN>.
# Needs a wildcard DNS record *.<ASSET_BASE_DOMAIN> -> <SERVER_IP> (DNS only, not proxied).
ASSET_BASE_DOMAIN=
# Shown to users as the A-record target for apex custom domains
SERVER_IP=<SERVER_IP>

# SSO (auth.wiredhowse.app) — same AUTH_SECRET the auth app signs with
AUTH_SERVER=https://auth.wiredhowse.app
AUTH_SECRET=
SESSION_SECRET=

# GitHub — classic PAT with repo + delete_repo scopes; asset repos go under this org
GITHUB_TOKEN=
GITHUB_ORG=wirehouseworkers

# Anthropic — shared key for site generation
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

MONTHLY_BUILD_LIMIT=50
MAX_EDITS_PER_BUILD=5
SUGGESTIONS_EMAIL=suggestions@wiredhowse.app